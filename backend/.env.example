# ── Environment Variables Template ─────────────────────────────────────────────
# Copy this file to .env and fill in values. Never commit .env to git.
#
# ─── Application ───────────────────────────────────────────────────────────────
APP_NAME=MarketSurveillanceAPI
APP_ENV=local                      # local | production
DEBUG=true
SECRET_KEY=changeme-use-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Database ──────────────────────────────────────────────────────────────────
# Local SQLite (zero setup — used by default when APP_ENV=local)
DATABASE_URL=sqlite:///./market_surveillance.db

# Production RDS PostgreSQL (Install psycopg2-binary; provide connection string)
# DATABASE_URL=postgresql://postgres:YOUR_RDS_PASSWORD@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/market_surveillance

# ─── AWS Services (all optional locally — system falls back to local stubs) ────
AWS_REGION=ap-south-1

# SQS — leave blank to use local in-process queue
SQS_QUEUE_URL=

# SNS — leave blank to print alerts to console instead of emailing
SNS_TOPIC_ARN=

# S3 — leave blank to save reports to ./storage/reports/ locally
S3_BUCKET_NAME=

# Parameter Store — Set to true on EC2 to automatically fetch /market_surveillance/*
USE_PARAMETER_STORE=false
SSM_PARAM_PREFIX=/market_surveillance/

# AWS credentials — DO NOT set these on EC2 (use IAM instance role instead)
# Only needed for local development when testing directly against real AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Data Paths ────────────────────────────────────────────────────────────────
# Path to data folder containing symbols.csv, traders.csv, market_events.csv
DATA_DIR=../data

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In production on AWS, include your ALB DNS name, CloudFront domain, or '*'
# Example: CORS_ORIGINS=http://localhost:5173,http://my-alb-123456.ap-south-1.elb.amazonaws.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,*
