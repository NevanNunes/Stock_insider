# ── Environment Variables Template ─────────────────────────────────────────────
# Copy this file to .env and fill in values. Never commit .env to git.
#
# ─── Application ───────────────────────────────────────────────────────────────
APP_NAME=MarketSurveillanceAPI
APP_ENV=local                      # local | production
DEBUG=true
SECRET_KEY=changeme-use-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Database ──────────────────────────────────────────────────────────────────
# Local SQLite  (zero setup — used by default when APP_ENV=local)
DATABASE_URL=sqlite:///./market_surveillance.db

# Local PostgreSQL (optional, comment out the sqlite line and use this instead)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/market_surveillance

# Production RDS (set by AWS Parameter Store when deployed — leave blank locally)
# DATABASE_URL=postgresql://user:password@your-rds-endpoint:5432/market_surveillance

# ─── AWS Services (all optional locally — system falls back to local stubs) ────
AWS_REGION=ap-south-1

# SQS  — leave blank to use local in-process queue
SQS_QUEUE_URL=

# SNS  — leave blank to print alerts to console instead of emailing
SNS_TOPIC_ARN=

# S3   — leave blank to save reports to ./storage/reports/ locally
S3_BUCKET_NAME=

# AWS credentials — DO NOT set these on EC2 (use IAM instance role instead)
# Only needed for local development when you want to test against real AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Data Paths ────────────────────────────────────────────────────────────────
DATA_DIR=../data

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
